# FinGround configuration. Copy to `.env` and fill in what you have.
# The LLM wrapper is provider-agnostic: set whichever keys you use.
# Missing providers are simply skipped by the benchmark.

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Cohere — a free trial key from dashboard.cohere.com works (rate-limited).
COHERE_API_KEY=
# OpenAI-compatible hosted providers (uncomment the ones you use). Several have
# free tiers; see README "Hosted models" for example model specs.
# Mistral — console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# Google Gemini — aistudio.google.com/apikey
# GEMINI_API_KEY=
# Groq — console.groq.com/keys
# GROQ_API_KEY=
# Cerebras — cloud.cerebras.ai
# CEREBRAS_API_KEY=
# OpenRouter — openrouter.ai/settings/keys (":free" model variants cost nothing)
# OPENROUTER_API_KEY=
# GitHub Models — github.com/settings/tokens (fine-grained token with "Models: read")
# GITHUB_TOKEN=

# Local models via Ollama (no key needed; just the base URL).
OLLAMA_BASE_URL=http://localhost:11434
# Explicit context window for Ollama requests. Ollama's own default is small
# (~2k) and silently truncates the front of RAG prompts — keep this above the
# prompt size (~4-5k tokens with default top_k).
OLLAMA_NUM_CTX=8192

# --- SEC EDGAR ---
# EDGAR requires a descriptive User-Agent with contact info. Be a good citizen.
SEC_EDGAR_USER_AGENT=FinGround research your-name your-email@example.com

# --- Defaults (optional overrides) ---
# Embedding model for the dense index.
FINGROUND_EMBED_MODEL=BAAI/bge-base-en-v1.5
# Default answering model (provider:model form, e.g. openai:gpt-4o-mini).
FINGROUND_ANSWER_MODEL=openai:gpt-4o-mini
# Default LLM-as-judge model.
FINGROUND_JUDGE_MODEL=openai:gpt-4o
