# Copy to .env (gitignored) and fill in, or run ./init-env.sh to generate one.
# Every value here is a local-only secret for the Docker stack; none of them
# are used anywhere else.

# Host ports (bound to 127.0.0.1 only).
LANGFUSE_PORT=3100
LANGFUSE_MINIO_PORT=9190

# Infrastructure credentials.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# Langfuse app secrets.
NEXTAUTH_SECRET=        # openssl rand -base64 32
SALT=                   # openssl rand -base64 32
ENCRYPTION_KEY=         # openssl rand -hex 32  (exactly 64 hex chars)

# Headless first-run setup: project API keys + admin login for the UI.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-...
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-...
LANGFUSE_INIT_USER_EMAIL=admin@finground.local
LANGFUSE_INIT_USER_PASSWORD=
